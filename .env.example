# onelineFlow — copy to .env and fill in.
# The process refuses to boot if anything here is missing or malformed. That is
# deliberate: a worker that starts happily and throws on its first job at 3am
# during month-end close is far worse than one that never starts.

NODE_ENV=development
SERVICE_NAME=onelineflow
LOG_LEVEL=debug

# --- Postgres ---------------------------------------------------------------
# Port 5442 by default so the compose stack coexists with a local Postgres.
DATABASE_URL=postgres://onelineflow:onelineflow@localhost:5442/onelineflow
# DATABASE_REPLICA_URL=postgres://onelineflow:onelineflow@localhost:5443/onelineflow
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6390
QUEUE_PREFIX=of
WORKER_CONCURRENCY=25

# --- Object storage (MinIO locally, S3 in production) -----------------------
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=onelineflow-documents
S3_ACCESS_KEY_ID=onelineflow
S3_SECRET_ACCESS_KEY=onelineflow-dev-secret
S3_FORCE_PATH_STYLE=true

# --- Encryption -------------------------------------------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# PRODUCTION: this must come from KMS/Vault, not a plain env var. It protects
# every tenant's QuickBooks refresh token — one of those grants indefinite
# read/write access to a company's general ledger.
ENCRYPTION_ROOT_KEY=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64_ENCODED==
ENCRYPTION_KEY_VERSION=1

# --- Intuit / QuickBooks Online ---------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/v1/qbo/callback
QBO_ENVIRONMENT=sandbox
QBO_MINOR_VERSION=75
# Intuit's documented ceiling is ~500 req/min/realm. 450 leaves headroom for
# retries and for anything else touching the same realm.
QBO_RATE_LIMIT_PER_MIN=450
QBO_MAX_CONCURRENT_PER_REALM=8
QBO_REQUEST_TIMEOUT_MS=30000
QBO_WEBHOOK_VERIFIER_TOKEN=

# --- AI extraction ----------------------------------------------------------
# At least one provider is required. Two are strongly recommended: the consensus
# gate is what makes auto-posting safe, and it needs a second, architecturally
# DIFFERENT model. Two models from the same family make correlated mistakes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# Below this confidence an invoice always goes to a human, whatever else agrees.
AI_AUTOPOST_CONFIDENCE_THRESHOLD=0.95
# Run the second model only when the first is below this. Cost control: in
# steady state most invoices are clean scans from repeat vendors, so the second
# call is rare and the safety is nearly free.
AI_CONSENSUS_TRIGGER_THRESHOLD=0.98
AI_REQUEST_TIMEOUT_MS=90000

# --- API --------------------------------------------------------------------
HTTP_PORT=3000
HTTP_HOST=0.0.0.0
HTTP_BODY_LIMIT_BYTES=26214400
JWT_PUBLIC_KEY=

# --- Observability ----------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9464

# --- Local compose port overrides (docker-compose.yml only) -----------------
# POSTGRES_PORT=5442
# REDIS_PORT=6390
# MINIO_PORT=9010
# MINIO_CONSOLE_PORT=9011
