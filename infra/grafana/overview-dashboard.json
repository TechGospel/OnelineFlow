{
  "uid": "onelineflow-overview",
  "title": "onelineFlow \u2014 Platform Overview",
  "description": "Invoice pipeline health. Organised by what a responder needs first: is work flowing, is anything stuck, is anything wrong with QuickBooks.",
  "tags": ["onelineflow"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Outbox oldest age",
      "description": "THE relay health signal. Backlog count is misleading \u2014 a relay wedged on one poisoned row shows a small stable count while latency climbs.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "onelineflow_outbox_oldest_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Invoices posted / hr",
      "description": null,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(onelineflow_invoice_transitions_total{to=\"posted\"}[1h])) * 3600",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Awaiting human review",
      "description": null,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(onelineflow_queue_depth{queue=\"extraction\",state=\"waiting\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Duplicate posts prevented (24h)",
      "description": "Guards firing means the system is working. A SUSTAINED rate means something upstream is generating duplicate attempts.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(onelineflow_duplicate_posts_prevented_total[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Invoice transitions / sec",
      "description": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(onelineflow_invoice_transitions_total[5m])) by (to)",
          "legendFormat": "{{to}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingestion rate by source",
      "description": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(onelineflow_invoices_ingested_total[5m])) by (source, deduplicated)",
          "legendFormat": "{{source}} dedup={{deduplicated}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "description": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(onelineflow_queue_depth) by (queue, state)",
          "legendFormat": "{{queue}} / {{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox backlog vs age",
      "description": "Watch AGE, not count. They diverge exactly when the relay is stuck.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "onelineflow_outbox_backlog",
          "legendFormat": "rows",
          "refId": "A"
        },
        {
          "expr": "onelineflow_outbox_oldest_age_seconds",
          "legendFormat": "oldest age (s)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Extraction confidence percentiles",
      "description": "A falling p10 means more invoices routed to humans. Usually a model change or a shift in document mix.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(onelineflow_extraction_confidence_bucket[10m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.1, sum(rate(onelineflow_extraction_confidence_bucket[10m])) by (le))",
          "legendFormat": "p10",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Extraction latency",
      "description": null,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(onelineflow_extraction_duration_seconds_bucket[10m])) by (le, model))",
          "legendFormat": "p95 {{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI spend rate (per hour)",
      "description": "Cost is the dominant variable at volume. A step change usually means the second-opinion skip rate dropped.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(onelineflow_ai_cost_micros_total[30m])) by (provider) * 3600 / 1000000",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "QBO request rate by outcome",
      "description": null,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(onelineflow_qbo_requests_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "QBO faults by code",
      "description": "6240=duplicate (guard working). 3200/3100=auth, tenant must reconnect. 3001=throttled.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(onelineflow_qbo_requests_total{outcome=\"failure\"}[10m])) by (fault_code)",
          "legendFormat": "{{fault_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "QBO latency and rate-limit waits",
      "description": "Rising limiter wait means we are saturating the per-realm budget.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(onelineflow_qbo_request_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "p95 request",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(onelineflow_qbo_rate_limit_wait_seconds_bucket[10m])) by (le))",
          "legendFormat": "p95 limiter wait",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stalled tenants",
      "description": null,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(onelineflow_tenant_pipeline_stalled) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database pool",
      "description": null,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "onelineflow_db_pool",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scheduler heartbeat age",
      "description": "Covers every scheduler failure mode at once: crashed, wedged, descheduled, or silently erroring.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - onelineflow_scheduler_last_sweep_timestamp_seconds",
          "legendFormat": "seconds since last sweep",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  }
}
